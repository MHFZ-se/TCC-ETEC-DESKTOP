@{
    ViewBag.Title = "Início";
}

<!DOCTYPE html>

<html>
<head>

    <title>PlantHealth</title>

    <link rel="stylesheet" href="~/css/site.css" />

</head>
<body>

    <div class="hero">
        <div class="overlay">
            <h1>PlantHealth</h1>

            <p>
                Monitoramento inteligente
                da saúde das plantas
            </p>

            <div class="buttons">
                <a href="/Home/Login"
                   class="btn green">
                    Logar
                </a>

                <a href="/Home/Cadastro"
                   class="btn white">
                    Cadastrar
                </a>
            </div>
        </div>
    </div>

    <section class="about">
        <h1>
            Sobre o nosso projeto
        </h1>

        <p>
            O PlantHealth é uma plataforma
            de monitoramento inteligente
            para análise da saúde das plantas.

            Utilizando o sensor TCS3200,
            o sistema identifica alterações
            na coloração das folhas e
            auxilia na detecção precoce
            de doenças, deficiência de
            nutrientes e pragas.
        </p>

        <div class="about-grid">
            <div class="about-card">
                <h2>
                    Monitoramento
                </h2>

                <p>
                    Análise automática das folhas
                </p>
            </div>

            <div class="about-card">
                <h2>
                    Relatórios
                </h2>

                <p>
                    Histórico de escaneamentos
                </p>
            </div>

            <div class="about-card">
                <h2>
                    Sensor TCS3200
                </h2>

                <p>
                    Leitura RGB inteligente
                </p>
            </div>
        </div>
    </section>
</body>
</html>