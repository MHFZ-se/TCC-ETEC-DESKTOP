@{
    ViewBag.Title = "Dispositivos";
}

<div class="device-page">
    <h1>
        Selecionar Dispositivo
    </h1>

    <div class="grid">
        @for (int i = 1; i <= 6; i++)
        {
            <a href="/Home/Dashboard"
               class="device">
                <h2>
                    Sensor @i
                </h2>
            </a>
        }
    </div>
</div>