<!DOCTYPE html>

<html>
<head>

    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>
        @ViewBag.Title - PlantHealth
    </title>

    <link rel="stylesheet" href="~/css/site.css" />

    <script src="~/js/site.js"></script>

</head>
<body>

    <nav class="navbar">

        <div class="nav-container">

            <!-- LOGO -->

            <a href="@Url.Action("Index","Home")"
               class="logo-brand">

                <img src="~/img/logo.png"
                     alt="PlantHealth">

                <span>

                    PlantHealth

                </span>

            </a>

            <!-- LINKS -->

            <div class="nav-links">

                @Html.ActionLink(
                "Contato",
                "Contato",
                "Home",
                null,
                new
                {
                    @class = "nav-btn login-btn"
                })

                @Html.ActionLink(
                "Login",
                "Login",
                "Home",
                null,
                new
                {
                    @class = "nav-btn login-btn"
                })

                @Html.ActionLink(
                "Cadastrar",
                "Cadastro",
                "Home",
                null,
                new
                {
                    @class = "nav-btn register-btn"
                })

            </div>

        </div>

    </nav>

    <div class="body-content">

        @RenderBody()

        <footer class="footer">

            <p>

                © Copyright
                @DateTime.Now.Year
                PlantHealth

            </p>

        </footer>

    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js">
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    @await RenderSectionAsync(
    "Scripts",
    required: false)
</body>
</html>